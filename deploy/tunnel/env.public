# The public deployment's policy. Sourced by every script that starts the
# live server so no restart can fall back to the personal-machine defaults.
export DRUMS_LINKS=0                  # upload-only
export DRUMS_ALLOW_YOUTUBE=0
export DRUMS_YOUTUBE_WITH_CONSENT=0
export DRUMS_ZERO_RETENTION=1         # nothing audio is kept after delivery
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
